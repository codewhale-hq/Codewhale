{
  "schema_version": 1,
  "default_profile": "standard",
  "custom_allowed_profiles": ["standard"],
  "profiles": [
    {
      "id": "standard",
      "endpoint": { "path": "versioned_responses" },
      "headers": { "protocol_headers": "standard_json" },
      "request": {
        "store": "explicit_false",
        "include": "encrypted_reasoning",
        "instructions": "top_level",
        "max_output_tokens": "when_positive",
        "sampling": "omit"
      },
      "reasoning": {
        "effort_mapping": "openai_compatible",
        "shape": "effort_with_summary",
        "summary": "auto"
      },
