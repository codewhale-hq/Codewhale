        "encrypted_state": "provider_api_model_scoped",
        "plain_reasoning": "ignore",
        "system_role": "preserve"
      },
      "tools": {
        "envelope": "function_array",
        "namespace": null,
        "parallel_calls": "allow"
      },
      "stream": {
        "malformed_json": "skip_with_diagnostic",
        "unknown_event": "ignore",
        "done_marker": "terminal",
        "completion": "accept_documented_terminal_events",
        "incomplete": "preserve_provider_incomplete_result"
      },
      "usage": {
        "cache_fields": "top_level_then_nested_fallback",
        "reasoning_fields": "output_tokens_details",
        "audio_fields": "nested_details"
      },
      "capabilities": {
        "function_tools": "supported",
        "server_side_tools": "route_and_adapter_gated"
      }
    },
