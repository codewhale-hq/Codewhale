{
  "name": "@codewhale/extension-host",
  "version": "0.1.0",
  "description": "Codewhale's TypeScript extension host: runs reviewed plugin code (Cordis/DSH model) behind the Rust core's approval gate.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:bun": "bun test --timeout 30000 ./test/",
    "compile": "node compile-host.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cosmokit": "1.9.0",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.4",
    "@types/semver": "7.8.0",
    "acorn": "8.18.0",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.2",
    "semver": "7.8.5",
    "typescript": "5.9.3"
  }
}
